---
import '../styles/global.css';
import VideoCard from '../components/VideoCard.astro';

const videos = [
  {
    title: "7 Dinangal — Cinematography",
    src: "/videos/7_dinangal_centered.mp4"
  },
  {
    title: "Wonder Woman — Short Film",
    src: "/videos/wonder_woman_centered_reel.mp4"
  },
  {
    title: "KNU Indian Fiesta — Choreography",
    src: "/videos/dance_reel_500.mp4"
  },
  {
    title: "A Tinder Date — Short Film",
    src: "/videos/tinder_date_reel.mp4"
  },
  {
    title: "KNU Interview — Christ University",
    src: "/videos/knu_interview_reel.mp4"
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Curated Vault</title>
  </head>
  <body class="bg-[#FAFAFA] min-h-screen font-sans antialiased">
    <main class="max-w-2xl mx-auto px-6 py-16 md:py-24">
      <header class="mb-12">
        <h1 class="text-2xl font-semibold text-stone-800 tracking-tight">Vault.</h1>
        <p class="text-sm text-stone-500 mt-2 font-light">A curated collection of visual fragments.</p>
      </header>

      <section class="grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3">
        {videos.map((video) => (
          <VideoCard title={video.title} videoSrc={video.src} />
        ))}
      </section>
    </main>
  </body>
</html>

