---
export interface Props {
  title: string;
  videoSrc: string;
}
const { title, videoSrc } = Astro.props;
---

<div class="group relative flex flex-col gap-5">
  <div class="relative w-full aspect-[9/16] overflow-hidden rounded-md bg-[#121212] border border-zinc-800 transition-all duration-700 ease-out group-hover:border-zinc-500 group-hover:shadow-[0_0_40px_rgba(255,255,255,0.03)]">
    <video 
      src={videoSrc} 
      controls 
      playsinline 
      preload="metadata"
      class="w-full h-full object-cover opacity-85 transition-opacity duration-700 group-hover:opacity-100 grayscale-[20%] group-hover:grayscale-0"
    ></video>
  </div>
  
  <div class="flex items-center gap-3 px-1">
    <div class="h-[1px] w-3 bg-zinc-700 transition-all duration-500 ease-out group-hover:w-8 group-hover:bg-zinc-300"></div>
    <h3 class="text-[11px] uppercase tracking-[0.2em] text-zinc-500 font-medium transition-colors duration-500 group-hover:text-zinc-100">
      {title}
    </h3>
  </div>
</div>
