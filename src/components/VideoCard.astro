---
export interface Props {
  title: string;
  videoSrc: string;
}
const { title, videoSrc } = Astro.props;
---

<div class="flex flex-col gap-3 group">
  <div class="relative w-full aspect-[9/16] overflow-hidden rounded-2xl shadow-sm border border-stone-200/50 bg-stone-100">
    <video 
      src={videoSrc} 
      controls 
      playsinline 
      preload="metadata"
      class="w-full h-full object-cover"
    ></video>
  </div>
  <h3 class="text-sm font-medium text-stone-700 tracking-wide px-1">
    {title}
  </h3>
</div>

